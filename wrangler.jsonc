{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "careercclub-internal",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-28",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }

  // The production hostname is served by Caddy on the VPS. Do not claim
  // internal.ccclub.id as a Worker Custom Domain while that deployment is active.
  // After creating Hyperdrive, add:
  // "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "<HYPERDRIVE_ID>" }]
}
