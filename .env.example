DATABASE_URL=postgres://user:password@localhost:5432/careercclub_internal
# Optional Vercel-style alias. DATABASE_URL takes precedence when both are set.
POSTGRES_URL=
POSTGRES_MAX_CONNECTIONS=10
POSTGRES_PREPARE=true
# Used by `next dev` when the deployed Worker uses a Hyperdrive binding.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=

AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=true
# Optional bootstrap login while auth_users is empty.
AUTH_ADMIN_EMAIL=admin@careercclub.com
AUTH_ADMIN_PASSWORD=change-me

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Google Cloud OAuth 2.0 Web client ID (not an API key or client secret).
# Enable Google Calendar API and add the deployed origin to Authorized JavaScript origins.
GOOGLE_OAUTH_CLIENT_ID=

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ccc-ops
# Optional custom domain for public objects, without a trailing slash.
R2_PUBLIC_BASE_URL=

# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@ccclub.id
